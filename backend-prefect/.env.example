# Supabase -> Project Settings -> API. Usa la service_role / secret key (solo backend, nunca en el front)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=tu-service-role-key
JWT_SECRET=pon-aqui-un-string-largo-y-aleatorio
# Si dejas SUPABASE_URL/KEY vacíos, el backend usa un repositorio en memoria (plan B)
